{
  "name": "react-ios-style-picker",
  "version": "0.0.4",
  "description": "A highly customizable iOS-style picker and bottom sheet component library for React",
  "keywords": [
    "react",
    "react-component",
    "picker",
    "ios",
    "style",
    "react-ios-style-picker"
  ],
  "main": "./dist/bundle.js",
  "module": "./dist/esm/bundle.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/bundle.js",
      "import": "./dist/esm/bundle.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/bundle.js",
    "dist/bundle.js.map",
    "dist/esm/bundle.js",
    "dist/esm/bundle.js.map",
    "dist/index.d.ts",
    "dist/dts/components",
    "dist/dts/hooks/useScrollSelection.d.ts",
    "dist/dts/index.d.ts",
    "dist/esm/dts/components",
    "dist/esm/dts/hooks/useScrollSelection.d.ts",
    "dist/esm/dts/index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/reeseo3o/react-ios-style-picker.git"
  },
  "homepage": "https://github.com/reeseo3o/react-ios-style-picker#readme",
  "bugs": {
    "url": "https://github.com/reeseo3o/react-ios-style-picker/issues"
  },
  "author": "reeseo3o",
  "scripts": {
    "build:types": "tsc --emitDeclarationOnly",
    "build:js": "rollup -c",
    "build": "npm run build:types && npm run build:js",
    "watch": "rollup -cw",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "npm run build && npm test",
    "storybook": "storybook dev -p 6006 --host localhost",
    "build-storybook": "storybook build"
  },
  "license": "MIT",
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.12.3",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@chromatic-com/storybook": "^4.1.3",
    "@rollup/plugin-alias": "^5.1.1",
    "@rollup/plugin-babel": "^6.1.0",
    "@rollup/plugin-commonjs": "^29.0.0",
